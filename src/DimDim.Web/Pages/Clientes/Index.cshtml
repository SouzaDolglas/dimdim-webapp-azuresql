@page
@model DimDim.Web.Pages.Clientes.IndexModel
@{ ViewData["Title"] = "Clientes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Clientes</h1>
    <a class="btn btn-success" asp-page="Create">+ Novo cliente</a>
</div>

@if (TempData["msg"] is string msg) { <div class="alert alert-info">@msg</div> }

<table class="table table-hover align-middle">
    <thead><tr><th>ID</th><th>Nome</th><th>CPF</th><th>E-mail</th><th>Contas</th><th>Cadastrado em</th><th></th></tr></thead>
    <tbody>
    @foreach (var c in Model.Clientes)
    {
        <tr>
            <td>@c.Id</td><td>@c.Nome</td><td>@c.Cpf</td><td>@c.Email</td>
            <td>@c.Contas.Count</td>
            <td>@c.DataCadastro.ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@c.Id">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@c.Id">Excluir</a>
            </td>
        </tr>
    }
    @if (Model.Clientes.Count == 0) { <tr><td colspan="7" class="text-muted">Nenhum cliente cadastrado.</td></tr> }
    </tbody>
</table>
